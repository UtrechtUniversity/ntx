{
  "name": "ntx-frontend",
  "version": "0.0.1",
  "scripts": {
    "copy:plotly": "node ./scripts/copy-plotly.mjs",
    "dev:css": "npx @tailwindcss/cli -i ./src/input.css -o ../static/css/tailwind.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ../static/css/tailwind.css --minify",
    "dev:js": "npx esbuild ./src/app.js --bundle --sourcemap --outfile=../static/ntx/app.js --platform=browser --watch",
    "build:js": "npx esbuild ./src/app.js --bundle --minify --outfile=../static/ntx/app.js --platform=browser",
    "dev": "npm run copy:plotly && concurrently --raw -k -s first \"npm:dev:css\" \"npm:dev:js\"",
    "build": "npm run copy:plotly && npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "alpinejs": "^3.15.2",
    "concurrently": "^9.1.0",
    "esbuild": "^0.25.0",
    "plotly.js-dist-min": "^3.3.1",
    "tailwindcss": "^4.1.17"
  }
}
