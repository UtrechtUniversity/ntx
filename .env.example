# For overriding the values used for automatic superuser creation during container startup.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
# Optional; blank email address is allowed.
DJANGO_SUPERUSER_EMAIL=

# SMTP overrides for docker-compose.prod.yaml (development writes email to files).
# Required environment variables when deploying the image directly.
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_PORT=587
EMAIL_USE_TLS=True
